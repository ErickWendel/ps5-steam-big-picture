#!/usr/bin/env python3
"""Open Steam's gamepad UI when the DualSense PS button is pressed."""

import errno
import fcntl
import glob
import json
import os
import selectors
import struct
import subprocess
import time
from dataclasses import dataclass
from enum import Enum, auto


EV_KEY = 0x01
BTN_MODE = 0x13C          # The PS button in the Linux DualSense driver.
KEY_HOMEPAGE = 0x0AC      # Fallback mapping used by some Bluetooth adapters.
EVIOCGNAME = 0x80004506
EVENT_STRUCT = struct.Struct("llHHI")
RESTORE_DELAY = 2.0


class LifecycleState(Enum):
    """Observable Steam session states relevant to returning to Big Picture."""

    IDLE = auto()
    BIG_PICTURE_ACTIVE = auto()
    GAME_ACTIVE = auto()
    RETURN_PENDING = auto()
    RETURN_COMPLETED = auto()


class LifecycleAction(Enum):
    NONE = auto()
    RESTORE_BIG_PICTURE = auto()


@dataclass
class BigPictureLifecycle:
    """One-shot state machine for a game launched from Big Picture.

    Window disappearance alone never triggers a restore. A return is armed only
    when a game/overlay becomes active after Big Picture was observed.
    """

    restore_delay: float = RESTORE_DELAY
    state: LifecycleState = LifecycleState.IDLE
    restore_at: float | None = None

    def big_picture_requested(self):
        """Record an explicit user request without creating a return request."""
        self.state = LifecycleState.BIG_PICTURE_ACTIVE
        self.restore_at = None

    def observe(self, now, big_picture_visible, overlay_running, game_running):
        session_running = overlay_running or game_running

        if self.state is LifecycleState.IDLE:
            if big_picture_visible and not session_running:
                self.state = LifecycleState.BIG_PICTURE_ACTIVE

        elif self.state is LifecycleState.BIG_PICTURE_ACTIVE:
            if session_running:
                self.state = LifecycleState.GAME_ACTIVE
            elif not big_picture_visible:
                # Big Picture was minimized or closed before a game started.
                self.state = LifecycleState.IDLE

        elif self.state is LifecycleState.GAME_ACTIVE:
            if not session_running:
                self.state = LifecycleState.RETURN_PENDING
                self.restore_at = now + self.restore_delay

        elif self.state is LifecycleState.RETURN_PENDING:
            if session_running:
                # Overlay and game processes can disappear in either order and
                # briefly race during shutdown. Wait for both to stay gone.
                self.state = LifecycleState.GAME_ACTIVE
                self.restore_at = None
            elif self.restore_at is not None and now >= self.restore_at:
                # Disarm before performing the side effect. A slow/missing Steam
                # window therefore cannot cause another polling-cycle restore.
                self.state = LifecycleState.RETURN_COMPLETED
                self.restore_at = None
                return LifecycleAction.RESTORE_BIG_PICTURE

        elif self.state is LifecycleState.RETURN_COMPLETED:
            if big_picture_visible and not session_running:
                self.state = LifecycleState.BIG_PICTURE_ACTIVE

        return LifecycleAction.NONE


def device_name(fd):
    name = bytearray(256)
    try:
        fcntl.ioctl(fd, EVIOCGNAME + (len(name) << 16), name)
    except OSError:
        return ""
    return bytes(name).split(b"\0", 1)[0].decode(errors="replace")


def is_dualsense(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return False

    try:
        name = device_name(fd).lower()
        return "dualsense" in name or "wireless controller" in name
    finally:
        os.close(fd)


def process_is_running(name):
    """Return whether a process with the exact Linux comm name is running."""
    for path in glob.glob("/proc/[0-9]*/comm"):
        try:
            with open(path, encoding="utf-8") as comm_file:
                if comm_file.read().strip() == name:
                    return True
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
    return False


def log(message):
    subprocess.run(
        ["logger", "-t", "ps5-steam-big-picture", message],
        check=False,
    )


def visible_steam_window():
    """Return the best visible Steam window reported by Hyprland."""
    try:
        result = subprocess.run(
            ["hyprctl", "clients", "-j"],
            capture_output=True,
            check=False,
            text=True,
            timeout=2,
        )
        clients = json.loads(result.stdout) if result.returncode == 0 else []
    except (json.JSONDecodeError, OSError, subprocess.TimeoutExpired):
        return None

    candidates = []
    for client in clients:
        window_class = str(client.get("class", "")).lower()
        if window_class != "steam":
            continue
        if client.get("hidden") or not client.get("visible", True):
            continue

        width, height = client.get("size", [0, 0])
        title = str(client.get("title", "")).lower()
        candidates.append(
            (
                "big picture" in title or "gamepad" in title,
                max(0, width) * max(0, height),
                client,
            )
        )

    return max(candidates, default=(False, 0, None), key=lambda item: item[:2])[2]


def restore_steam_fullscreen(timeout=12.0):
    """Wait for Steam's returned window, then focus/fullscreen it once."""
    deadline = time.monotonic() + timeout

    while time.monotonic() < deadline:
        client = visible_steam_window()
        if client is None:
            time.sleep(0.5)
            continue

        address = str(client.get("address", ""))
        if not address.startswith("0x"):
            time.sleep(0.5)
            continue

        if client.get("fullscreen") != 2:
            window = f"address:{address}"
            subprocess.run(
                [
                    "hyprctl",
                    "dispatch",
                    f'hl.dsp.focus({{ window = "{window}" }})',
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            subprocess.run(
                [
                    "hyprctl",
                    "dispatch",
                    "hl.dsp.window.fullscreen({ "
                    f'window = "{window}", mode = "fullscreen", '
                    'action = "set", layout_aware = false })',
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
        log("Steam Big Picture fullscreen restored")
        return True

    log("Could not confirm Steam Big Picture fullscreen")
    return False


def launch_big_picture(message="PS button pressed; opening Steam Big Picture"):
    """Ask a new or already-running Steam client to open Big Picture."""
    subprocess.run(
        [
            "systemd-run",
            "--user",
            "--collect",
            "--quiet",
            "steam",
            "steam://open/bigpicture",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    log(message)
    restore_steam_fullscreen()


def handle_ps_button(last_launch):
    now = time.monotonic()
    if now - last_launch < 1.5:
        return last_launch, False

    # Let Steam handle the Guide button itself while a game and its overlay are
    # active. Sending another Big Picture request here backgrounds the game and
    # races the in-game overlay.
    if process_is_running("gameoverlayui") or process_is_running("gamescope"):
        log("PS button pressed in game; leaving it to Steam's overlay")
        return now, False

    # Launch through a transient user unit so Steam receives the graphical
    # environment imported into systemd by the current session. It also keeps
    # Steam and games out of this monitor service's cgroup.
    launch_big_picture()
    return now, True


def main():
    selector = selectors.DefaultSelector()
    open_devices = {}
    last_scan = 0.0
    last_launch = 0.0
    lifecycle = BigPictureLifecycle()
    next_overlay_check = 0.0

    while True:
        now = time.monotonic()
        if now - last_scan >= 1:
            last_scan = now
            paths = set(glob.glob("/dev/input/event*"))

            for path in paths - open_devices.keys():
                if not is_dualsense(path):
                    continue
                try:
                    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
                    selector.register(fd, selectors.EVENT_READ, path)
                    open_devices[path] = fd
                except OSError:
                    pass

            for path in set(open_devices) - paths:
                fd = open_devices.pop(path)
                try:
                    selector.unregister(fd)
                except Exception:
                    pass
                os.close(fd)

        if now >= next_overlay_check:
            # Walking /proc is relatively expensive on a busy gaming system.
            # Once per second is responsive enough without burning a CPU core.
            next_overlay_check = now + 1.0
            overlay_running = process_is_running("gameoverlayui")
            game_running = process_is_running("gamescope")
            steam_window = visible_steam_window()
            big_picture_visible = bool(
                steam_window
                and any(
                    marker in str(steam_window.get("title", "")).lower()
                    for marker in ("big picture", "gamepad")
                )
            )
            action = lifecycle.observe(
                now,
                big_picture_visible,
                overlay_running,
                game_running,
            )
            if action is LifecycleAction.RESTORE_BIG_PICTURE:
                launch_big_picture("Game closed; returning to Steam Big Picture")
                last_launch = now

        # Epoll returns immediately when no file descriptors are registered.
        # Sleep explicitly while no controller is connected so the monitor
        # does not busy-spin and consume a CPU core.
        if open_devices:
            events = selector.select(timeout=0.25)
        else:
            time.sleep(0.25)
            events = []

        for key, _ in events:
            fd = key.fd
            try:
                data = os.read(fd, EVENT_STRUCT.size * 32)
            except OSError as error:
                if error.errno in (errno.EAGAIN, errno.EWOULDBLOCK):
                    continue
                data = b""

            if not data:
                path = key.data
                open_devices.pop(path, None)
                selector.unregister(fd)
                os.close(fd)
                continue

            for offset in range(0, len(data) - EVENT_STRUCT.size + 1, EVENT_STRUCT.size):
                _, _, event_type, code, value = EVENT_STRUCT.unpack_from(data, offset)
                if event_type == EV_KEY and code in (BTN_MODE, KEY_HOMEPAGE) and value == 1:
                    last_launch, requested_big_picture = handle_ps_button(last_launch)
                    if requested_big_picture:
                        lifecycle.big_picture_requested()


if __name__ == "__main__":
    main()
