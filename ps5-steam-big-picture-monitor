#!/usr/bin/env python3
"""Open Steam's gamepad UI when the DualSense PS button is pressed."""

import errno
import fcntl
import glob
import os
import selectors
import struct
import subprocess
import time


EV_KEY = 0x01
BTN_MODE = 0x13C          # The PS button in the Linux DualSense driver.
KEY_HOMEPAGE = 0x0AC      # Fallback mapping used by some Bluetooth adapters.
EVIOCGNAME = 0x80004506
EVENT_STRUCT = struct.Struct("llHHI")


def device_name(fd):
    name = bytearray(256)
    try:
        fcntl.ioctl(fd, EVIOCGNAME + (len(name) << 16), name)
    except OSError:
        return ""
    return bytes(name).split(b"\0", 1)[0].decode(errors="replace")


def is_dualsense(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return False

    try:
        name = device_name(fd).lower()
        return "dualsense" in name or "wireless controller" in name
    finally:
        os.close(fd)


def steam_game_running(proc_root="/proc"):
    """Return whether Steam is tracking a launched game.

    Steam starts every game, including non-Steam shortcuts such as PCSX2,
    under ``reaper SteamLaunch AppId=...``. gameoverlayui only runs for games
    with Steam Input enabled, so it cannot identify every game.
    """
    for pid_dir in glob.glob(f"{proc_root}/[0-9]*"):
        try:
            with open(f"{pid_dir}/comm", encoding="utf-8") as comm_file:
                if comm_file.read().strip() != "reaper":
                    continue
            with open(f"{pid_dir}/cmdline", "rb") as cmdline_file:
                if b"\0SteamLaunch\0" in cmdline_file.read():
                    return True
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
    return False


def pcsx2_running(proc_root="/proc"):
    """Return whether PCSX2, which runs with Steam Input disabled, is open."""
    for path in glob.glob(f"{proc_root}/[0-9]*/cmdline"):
        try:
            with open(path, "rb") as cmdline_file:
                argv0 = cmdline_file.read().split(b"\0", 1)[0].lower()
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
        if b"pcsx2" in os.path.basename(argv0):
            return True
    return False


def log(message):
    subprocess.run(
        ["logger", "-t", "ps5-steam-big-picture", message],
        check=False,
    )


def launch_big_picture():
    """Ask a new or already-running Steam client to open Big Picture.

    Window placement is left to Steam and Hyprland. Focusing or fullscreening
    Steam's windows from here fought the compositor and pushed newly launched
    games behind Big Picture.
    """
    subprocess.run(
        [
            "systemd-run",
            "--user",
            "--collect",
            "--quiet",
            "steam",
            "steam://open/bigpicture",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    log("PS button pressed; opening Steam Big Picture")


def open_pcsx2_menu():
    """Open PCSX2's pause menu, which is navigable with its SDL controllers.

    Steam's overlay cannot take controller input inside PCSX2's Qt/xcb window,
    so PS2 shortcuts run with Steam Input disabled and the PS button is
    forwarded to PCSX2 as its Escape pause-menu hotkey instead.
    """
    try:
        result = subprocess.run(
            ["wtype", "-k", "Escape"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=2,
        )
    except (OSError, subprocess.TimeoutExpired):
        log("PS button pressed in PCSX2; could not send Escape")
        return False

    if result.returncode == 0:
        log("PS button pressed in PCSX2; opened its pause menu")
        return True
    log("PS button pressed in PCSX2; sending Escape failed")
    return False


def handle_ps_button(last_launch):
    now = time.monotonic()
    if now - last_launch < 1.5:
        return last_launch

    # During a game Steam handles the PS button itself through Steam Input.
    # Acting on the same press as well (Big Picture requests, injected keys)
    # conflicts with Steam's own overlay and UI mode transitions.
    # PCSX2 may also be started outside Steam (the Omarchy menu), where no
    # Steam reaper exists, so check for it first.
    if pcsx2_running():
        open_pcsx2_menu()
        return now
    if steam_game_running():
        return now

    # Launch through a transient user unit so Steam receives the graphical
    # environment imported into systemd by the current session. It also keeps
    # Steam and games out of this monitor service's cgroup.
    launch_big_picture()
    return now


def main():
    selector = selectors.DefaultSelector()
    open_devices = {}
    last_scan = 0.0
    last_launch = 0.0

    while True:
        now = time.monotonic()
        if now - last_scan >= 1:
            last_scan = now
            paths = set(glob.glob("/dev/input/event*"))

            for path in paths - open_devices.keys():
                if not is_dualsense(path):
                    continue
                try:
                    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
                    selector.register(fd, selectors.EVENT_READ, path)
                    open_devices[path] = fd
                except OSError:
                    pass

            for path in set(open_devices) - paths:
                fd = open_devices.pop(path)
                try:
                    selector.unregister(fd)
                except Exception:
                    pass
                os.close(fd)

        # Epoll returns immediately when no file descriptors are registered.
        # Sleep explicitly while no controller is connected so the monitor
        # does not busy-spin and consume a CPU core.
        if open_devices:
            events = selector.select(timeout=0.25)
        else:
            time.sleep(0.25)
            events = []

        for key, _ in events:
            fd = key.fd
            try:
                data = os.read(fd, EVENT_STRUCT.size * 32)
            except OSError as error:
                if error.errno in (errno.EAGAIN, errno.EWOULDBLOCK):
                    continue
                data = b""

            if not data:
                path = key.data
                open_devices.pop(path, None)
                selector.unregister(fd)
                os.close(fd)
                continue

            for offset in range(0, len(data) - EVENT_STRUCT.size + 1, EVENT_STRUCT.size):
                _, _, event_type, code, value = EVENT_STRUCT.unpack_from(data, offset)
                if event_type == EV_KEY and code in (BTN_MODE, KEY_HOMEPAGE) and value == 1:
                    last_launch = handle_ps_button(last_launch)


if __name__ == "__main__":
    main()
